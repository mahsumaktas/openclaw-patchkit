+  memoryFileLocks.set(lockKey, queued);
+  try {
+    await previous;
+    return await action();
+  } finally {
+    releaseCurrent?.();
+    if (memoryFileLocks.get(lockKey) === queued) {
+      memoryFileLocks.delete(lockKey);
+    }
+  }
